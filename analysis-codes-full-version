#5)  Outlier screening 

outcome_list <- c("BDNF", "CTSB", "SimonEffect", "NBACC_trials", "NBmeanRT_correct_trials")

screen_outliers_iqr <- function(df, var) {
  for (tm in levels(df$Time)) {
    x <- df %>% filter(Time == tm) %>% pull({{var}})
    Q1 <- quantile(x, 0.25, na.rm=TRUE)
    Q3 <- quantile(x, 0.75, na.rm=TRUE)
    IQRv <- Q3 - Q1
    lb <- Q1 - 1.5 * IQRv
    ub <- Q3 + 1.5 * IQRv
    
    out <- df %>%
      filter(Time == tm) %>%
      select(ID, Group, Time, value = {{var}}) %>%
      filter(!is.na(value) & (value < lb | value > ub))
    
    cat("\n--- IQR outlier screen:", deparse(substitute(var)), "| Time =", tm, "---\n")
    cat("Bounds:", lb, "to", ub, "\n")
    if (nrow(out) == 0) cat("No extreme values detected.\n")
    if (nrow(out) > 0) print(out)
  }
}

