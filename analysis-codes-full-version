# Function to calculate Mean and SE
mean_se <- function(x) {
  n <- sum(!is.na(x))
  mean_value <- mean(x, na.rm = TRUE)
  se_value <- sd(x, na.rm = TRUE) / sqrt(n)
  return(c(Mean = mean_value, SE = se_value))
}

