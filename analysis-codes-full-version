# 10) sensitivity analysis 

sensitivity_trim_resid <- function(outcome, add_education = FALSE) {
  fixed_terms <- if (add_education) {
    "Group*Time + Age + Sex + Education"
  } else {
    "Group*Time + Age + Sex"
  }
  fml <- as.formula(paste0(outcome, " ~ ", fixed_terms, " + (1|ID)"))
  m_full <- lmer(fml, data=Data, REML=FALSE, na.action=na.exclude)
  
  r <- resid(m_full)
  r_std <- as.numeric(scale(r))
  keep <- which(abs(r_std) <= 2)
  
  Data_trim <- Data[keep, ]
  m_trim <- lmer(fml, data=Data_trim, REML=FALSE, na.action=na.exclude)
  
  cat("\n================ Sensitivity:", outcome, "================\n")
  cat("Full n =", nrow(model.frame(m_full)), "\n")
  cat("Trim n =", nrow(model.frame(m_trim)), "\n")
  cat("Full Group:Time p = ", anova(m_full, type=3)["Group:Time", "Pr(>F)"], "\n")
  cat("Trim Group:Time p = ", anova(m_trim, type=3)["Group:Time", "Pr(>F)"], "\n")
  cat("========================================================\n")
  
  invisible(list(full=m_full, trimmed=m_trim))
}

