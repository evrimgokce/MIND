# 4) Linear Mixed Model for Myokines and Cognitive Outcomes

run_lmem <- function(outcome,
                     add_education = FALSE,
                     do_posthoc_interaction = TRUE,
                     do_within_group = TRUE,
                     p_adjust = "holm") {

  # Build model formula
  fixed_terms <- if (add_education) {
    "Group * Time + Age + Sex + Education"
  } else {
    "Group * Time + Age + Sex"
  }

  model_formula <- as.formula(paste(outcome, "~", fixed_terms, "+ (1 | ID)"))

  # Fit model (ML), keep NA rows excluded but preserve alignment for residuals/preds
  model <- lmer(
    model_formula,
    data = Data,
    REML = FALSE,
    na.action = na.exclude
  )

  cat("\n=================================================\n")
  cat("Outcome:", outcome, "\n")
  cat("Model:", deparse(model_formula), "\n")
  cat("=================================================\n\n")

  # Model summary + Type III ANOVA
  print(summary(model))
  cat("\n--- Type III ANOVA (Satterthwaite) ---\n")
  print(anova(model, type = 3))

  # Estimated marginal means for Group x Time cells
  cat("\n--- Estimated marginal means (Group x Time) ---\n")
  emm <- emmeans(model, ~ Group * Time)
  print(emm)

  # (A) Within-group change: post - pre for each group
  if (do_within_group) {
    cat("\n--- Within-group change (post - pre) ---\n")
    chg <- contrast(emm, method = "revpairwise", by = "Group")
    print(summary(chg, infer = TRUE, adjust = p_adjust))
  } else {
    chg <- NULL
  }

  # (B) Interaction (pairwise interaction contrasts):
  # Compare the (post-pre) changes BETWEEN groups
  # Only meaningful if you want group-vs-group differences in change
  if (do_posthoc_interaction) {
    cat("\n--- Pairwise interaction contrasts: differences in change scores ---\n")
    if (is.null(chg)) {
      chg <- contrast(emm, method = "revpairwise", by = "Group")
    }
    int_contr <- contrast(chg, method = "pairwise", by = NULL)  # key: by = NULL
    print(summary(int_contr, infer = TRUE, adjust = p_adjust))
  }

 invisible(list(model = model, emm = emm, chg = chg, int_contr = if (exists("int_contr")) int_contr else NULL))
}

