# Outlier analysis
variables <- c("BDNF", "CTSB",
               "NBmeanRT_correct_trials", "NBACC_trials",
               "SimonEffect")

for (var in variables) {
  for (tm in levels(Data$Time)) {

    data_subset <- Data %>%
      dplyr::select(ID, Time, all_of(var)) %>%
      dplyr::filter(Time == tm) %>%
      dplyr::rename(value = all_of(var))

    x <- data_subset$value

    Q1 <- quantile(x, 0.25, na.rm = TRUE)
    Q3 <- quantile(x, 0.75, na.rm = TRUE)
    IQR_val <- Q3 - Q1

    lower_bound <- Q1 - 1.5 * IQR_val
    upper_bound <- Q3 + 1.5 * IQR_val

    outliers <- data_subset %>%
      dplyr::filter(!is.na(value) & (value < lower_bound | value > upper_bound))

    cat("\nOutlier screening:", var, "| Time =", tm, "\n")
    if (nrow(outliers) > 0) {
      cat("N extreme values:", nrow(outliers), "\n")
      print(outliers)
      cat("Bounds:", lower_bound, "to", upper_bound, "\n")
    } else {
      cat("No extreme values detected.\n")
    }
  }
}


# Function to calculate Mean and SE
mean_se <- function(x) {
  n <- sum(!is.na(x))
  mean_value <- mean(x, na.rm = TRUE)
  se_value <- sd(x, na.rm = TRUE) / sqrt(n)
  return(c(Mean = mean_value, SE = se_value))
}

