# 8) Model diagnostics

check_diagnostics <- function(m, outcome_name="") {
  par(mfrow=c(2,2))
  plot(m, resid(.) ~ fitted(.), main=paste0(outcome_name, ": Resid vs Fitted"))
  qqnorm(resid(m), main=paste0(outcome_name, ": QQ Residuals"))
  qqline(resid(m))
  hist(resid(m), main=paste0(outcome_name, ": Residuals"), xlab="Residuals")
  plot(fitted(m), sqrt(abs(resid(m))), main=paste0(outcome_name, ": Scale-Location"),
       xlab="Fitted", ylab="sqrt(|resid|)")
  par(mfrow=c(1,1))
}

