# 6) LMEM function 
#    - tests Group×Time
#    - returns EMMs
#    - within-group change (post-pre)  
#    - BETWEEN-group differences in change (interaction contrasts) 

run_lmm <- function(outcome, add_education = FALSE, p_adjust = "holm") {
  
  fixed_terms <- if (add_education) {
    "Group*Time + Age + Sex + Education"
  } else {
    "Group*Time + Age + Sex"
  }
  
  fml <- as.formula(paste0(outcome, " ~ ", fixed_terms, " + (1|ID)"))
  
  m <- lmer(fml, data = Data, REML = FALSE, na.action = na.exclude)
  
  cat("\n====================================================\n")
  cat("Outcome:", outcome, "\n")
  cat("Model:", deparse(fml), "\n")
  cat("====================================================\n")
  
  # Type III tests
  an3 <- anova(m, type = 3)
  print(an3)
  
  # Estimated marginal means
  emm <- emmeans(m, ~ Group*Time)
  cat("\n--- EMMs (Group x Time) ---\n")
  print(emm)
  
  # Within-group changes: post - pre
  chg <- contrast(emm, method = "revpairwise", by = "Group")
  chg_sum <- summary(chg, infer=TRUE, adjust=p_adjust)
  cat("\n--- Within-group change (post - pre) ---\n")
  print(chg_sum)
  
  # Interaction contrasts (difference in change between groups) ✅
  int <- contrast(chg, method = "pairwise", by = NULL)
  int_sum <- summary(int, infer=TRUE, adjust=p_adjust)
  cat("\n--- Between-group differences in change (interaction contrasts) ---\n")
  print(int_sum)
  
  invisible(list(model=m, anova=an3, emm=emm, chg=chg_sum, int=int_sum))
}

