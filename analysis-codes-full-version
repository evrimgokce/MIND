# 4.5. Compare results with and without outliers
sensitivity_outlier_check <- function(outcome, add_education = FALSE) {

  fixed_terms <- if (add_education) {
    "Group * Time + Age + Sex + Education"
  } else {
    "Group * Time + Age + Sex"
  }

  fml <- as.formula(paste(outcome, "~", fixed_terms, "+ (1|ID)"))

  m_full <- lmer(fml, data = Data, REML = FALSE, na.action = na.exclude)

  # standardized residuals
  r <- resid(m_full)
  r_std <- as.numeric(scale(r))

  # threshold = |z| > 2 (common sensitivity rule)
  keep_idx <- which(abs(r_std) <= 2)
  Data_trim <- Data[keep_idx, ]

  m_trim <- lmer(fml, data = Data_trim, REML = FALSE, na.action = na.exclude)

  cat("\n=================================================\n")
  cat("Sensitivity (outlier) check for:", outcome, "\n")
  cat("Full model n =", nrow(model.frame(m_full)), "\n")
  cat("Trim model n =", nrow(model.frame(m_trim)), "\n")
  cat("-------------------------------------------------\n")
  cat("Full model Group:Time p = ",
      anova(m_full, type = 3)["Group:Time", "Pr(>F)"], "\n")
  cat("Trim model Group:Time p = ",
      anova(m_trim, type = 3)["Group:Time", "Pr(>F)"], "\n")
  cat("=================================================\n")

  invisible(list(full = m_full, trimmed = m_trim))
}

