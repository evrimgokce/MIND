# make an EMM barplot (same look across outcomes)
plot_emm_bar <- function(emm_obj, ylab, p_label = NULL, p_x = NULL, p_y = NULL) {

  emm_df <- as.data.frame(emm_obj) %>%
    mutate(
      Group = factor(Group, levels = c("cogT", "motT", "DTT")),
      Time  = factor(Time,  levels = c("pre", "post"))
    )

  p <- ggplot(emm_df, aes(x = Group, y = emmean, fill = Time)) +
    geom_bar(stat = "identity",
             position = position_dodge(width = 0.7),
             width = 0.65,
             color = "black") +
    geom_errorbar(
      aes(ymin = emmean - SE, ymax = emmean + SE),
      position = position_dodge(width = 0.7),
      width = 0.2
    ) +
    labs(
      y = ylab,
      x = "",
      fill = "Time"
    ) +
    scale_fill_manual(values = c("grey70", "lightpink")) +
    theme_classic(base_size = 14) +
    theme(
      axis.text.x = element_text(size = 14, face = "bold")  # larger group labels
    )

  # Optional p-value annotation
  if (!is.null(p_label) && !is.null(p_x) && !is.null(p_y)) {
    p <- p +
      annotate("segment", x = p_x - 0.15, xend = p_x + 0.15, y = p_y, yend = p_y) +
      annotate("text", x = p_x, y = p_y * 1.03, label = p_label, size = 5)
  }

  return(p)
}

